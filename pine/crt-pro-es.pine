// ══════════════════════════════════════════════════════════════════════════════
// CRT Pro — ES Futures | Indicator | Pine Script v6
// ══════════════════════════════════════════════════════════════════════════════
// Logic:
// 1. Identify a "reference candle" (significant range) N bars back
// 2. Detect a sweep: current candle wicks beyond ref candle high/low
//    but CLOSES back inside (liquidity grab + reversal)
// 3. Draw solid lines on ref candle wicks, dashed line on confirmation body
// 4. Smart filters: EMA slope + candle color + session time
// 5. Exit signals: opposite CRT OR EMA cross — whichever fires first
// 6. Trade levels: Entry, SL (sweep wick) and TP1/TP2/TP3 (R multiples) are
//    drawn per trade. The trade closes at SL, at TP3, or on the exit signals
//    above, whichever comes first.
// 7. Trade log: one JSON alert() per entry, TP hit and exit for the CRT Pro
//    Tracker Google Sheet (integrations/crt-pro-tracker). Signals and the
//    drawings above are unchanged.
// ══════════════════════════════════════════════════════════════════════════════

//@version=6
indicator("CRT Pro — ES Futures", overlay=true, max_lines_count=500, max_labels_count=200, max_boxes_count=200)

// ─── INPUTS ───────────────────────────────────────────────────────────────────

grpRef = "📊 Reference Candle"
lookback = input.int(3, "Lookback Bars", minval=1, maxval=20, group=grpRef, tooltip="How many bars back to look for the reference candle")
minRangeATR = input.float(0.75, "Min Range (× ATR)", step=0.05, group=grpRef, tooltip="Reference candle must be at least this multiple of ATR in range")
atrLen = input.int(14, "ATR Length", group=grpRef)

grpFilter = "🧠 Smart Filters"
useEMA = input.bool(true, "Trend Filter (EMA)", group=grpFilter)
emaLen = input.int(20, "EMA Length", minval=5, maxval=500, group=grpFilter)
useVol = input.bool(false, "Volume Confirmation", group=grpFilter)
volLen = input.int(20, "Volume MA Length", group=grpFilter)
volMult = input.float(1.5, "Volume Multiplier", step=0.05, group=grpFilter, tooltip="Confirmation candle volume must exceed this × the volume MA")
useTime = input.bool(true, "Session Time Filter", group=grpFilter, tooltip="Only allow signals during high-activity windows")
sess1Start = input.int(930, "Morning Session Start (HHMM ET)", group=grpFilter)
sess1End = input.int(1130, "Morning Session End (HHMM ET)", group=grpFilter)
sess2Start = input.int(1400, "Afternoon Session Start (HHMM ET)", group=grpFilter)
sess2End = input.int(1600, "Afternoon Session End (HHMM ET)", group=grpFilter)

grpStyle = "🎨 Style"
extBars = input.int(10, "Line Extension (bars)", minval=1, maxval=100, group=grpStyle)
showEMA = input.bool(true, "Show EMA", group=grpStyle)
showZone = input.bool(true, "Show Reference Zone", group=grpStyle)
wickColor = input.color(color.new(#2962FF, 0), "Wick Line Color", group=grpStyle)
confColor = input.color(color.new(#FF9800, 0), "Confirmation Line Color", group=grpStyle)
bullColor = input.color(color.new(#00E676, 0), "Buy Signal Color", group=grpStyle)
bearColor = input.color(color.new(#FF1744, 0), "Sell Signal Color", group=grpStyle)

grpLvl = "🎯 Entry / SL / Targets"
showLvls = input.bool(true, "Show Entry, SL and TP lines", group=grpLvl)
slBufTicks = input.int(0, "SL Buffer (ticks past the sweep wick)", minval=0, maxval=40, group=grpLvl, tooltip="0 = stop exactly at the signal candle's sweep wick")
tp1R = input.float(1.0, "TP1 (R)", minval=0.25, step=0.25, group=grpLvl, tooltip="R = distance from entry to SL")
tp2R = input.float(2.0, "TP2 (R)", minval=0.25, step=0.25, group=grpLvl)
tp3R = input.float(3.0, "TP3 (R)", minval=0.25, step=0.25, group=grpLvl)
entryLvlColor = input.color(color.new(color.white, 20), "Entry Line Color", group=grpLvl)
slLvlColor = input.color(color.new(#FF1744, 0), "SL Line Color", group=grpLvl)
tpLvlColor = input.color(color.new(#00E676, 0), "TP Line Color", group=grpLvl)

grpLog = "📝 Trade Log (webhook)"
logOn = input.bool(true, "Send trade log alerts", group=grpLog, tooltip="Fires one JSON alert() per entry, TP hit and exit. Create ONE TradingView alert on 'Any alert() function call' with the tracker's /exec URL as the webhook.")
logKey = input.string("", "Webhook Key", group=grpLog, tooltip="Optional. Must match SECRET in the tracker's Apps Script if you set one there.")

// ─── CORE CALCULATIONS ────────────────────────────────────────────────────────

atr14 = ta.atr(atrLen)
emaVal = ta.ema(close, emaLen)
volMA = ta.sma(volume, volLen)

// Reference candle values (fixed offset — avoids repainting)
refH = high[lookback]
refL = low[lookback]

// Reference candle must have meaningful range relative to ATR
isQualRef = (refH - refL) >= atr14[lookback] * minRangeATR

// ─── SWEEP & REVERSE PATTERNS ─────────────────────────────────────────────────
// Bullish CRT : wick sweeps BELOW refL but candle CLOSES ABOVE refL
// Bearish CRT : wick sweeps ABOVE refH but candle CLOSES BELOW refH

bullCandle = close > open // sweep candle must close green
bearCandle = close < open // sweep candle must close red

bullSetup = isQualRef and (low < refL) and (close > refL) and bullCandle
bearSetup = isQualRef and (high > refH) and (close < refH) and bearCandle

// ─── SMART FILTERS ────────────────────────────────────────────────────────────

emaSlope = emaVal - emaVal[2] // EMA direction over last 2 bars
inUptrend = close > emaVal or emaSlope > 0 // price above EMA OR EMA sloping up
inDowntrend = close < emaVal or emaSlope < 0 // price below EMA OR EMA sloping down
volOK = volume > (volMA * volMult)

// Session time filter (New York time)
nyTime = hour(time, "America/New_York") * 100 + minute(time, "America/New_York")
inSession = not useTime or
     (nyTime >= sess1Start and nyTime < sess1End) or
     (nyTime >= sess2Start and nyTime < sess2End)

// Operator must be at END of line for Pine Script line continuation
bullSignal = bullSetup and
     (not useEMA or inUptrend) and
     (not useVol or volOK) and
     inSession

bearSignal = bearSetup and
     (not useEMA or inDowntrend) and
     (not useVol or volOK) and
     inSession

// ─── DRAWING ──────────────────────────────────────────────────────────────────

if bullSignal or bearSignal
    startBar = bar_index - lookback
    endBar = bar_index + extBars
    confMid = (open + close) / 2.0

    // Solid lines: Reference candle HIGH and LOW wicks
    line.new(startBar, refH, endBar, refH, color=wickColor, width=2, style=line.style_solid)
    line.new(startBar, refL, endBar, refL, color=wickColor, width=2, style=line.style_solid)

    // Dashed line: Confirmation candle body midpoint
    line.new(bar_index, confMid, endBar, confMid, color=confColor, width=1, style=line.style_dashed)

    // Reference zone box
    if showZone
        box.new(startBar, refH, endBar, refL, border_color=color.new(wickColor, 60), bgcolor=color.new(wickColor, 88))

// ─── SIGNAL LABELS ────────────────────────────────────────────────────────────

plotshape(bullSignal, "CRT Buy", shape.labelup, location.belowbar, bullColor, text="▲ CRT BUY", textcolor=color.white, size=size.normal)
plotshape(bearSignal, "CRT Sell", shape.labeldown, location.abovebar, bearColor, text="▼ CRT SELL", textcolor=color.white, size=size.normal)

// ─── EMA PLOT ─────────────────────────────────────────────────────────────────

plot(showEMA ? emaVal : na, "EMA", color=color.new(color.yellow, 0), linewidth=2)

// ─── INFO TABLE ───────────────────────────────────────────────────────────────

var table infoTable = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 60), border_color=color.new(color.gray, 40), border_width=1, frame_color=color.gray, frame_width=1)

if barstate.islast
    table.cell(infoTable, 0, 0, "CRT Filter", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 40))
    table.cell(infoTable, 1, 0, "Status", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 40))

    trendStatus = not useEMA ? "OFF" : inUptrend ? "▲ BULL" : "▼ BEAR"
    trendCol = not useEMA ? color.gray : inUptrend ? color.lime : color.red
    table.cell(infoTable, 0, 1, "Trend (EMA" + str.tostring(emaLen) + ")", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 1, trendStatus, text_color=trendCol, text_size=size.tiny)

    volStatus = not useVol ? "OFF" : volOK ? "✔ HIGH" : "✘ LOW"
    volCol = not useVol ? color.gray : volOK ? color.lime : color.orange
    table.cell(infoTable, 0, 2, "Volume (×" + str.tostring(volMult) + ")", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 2, volStatus, text_color=volCol, text_size=size.tiny)

    refStatus = isQualRef ? "✔ VALID" : "✘ WEAK"
    refCol2 = isQualRef ? color.lime : color.orange
    table.cell(infoTable, 0, 3, "Ref Candle", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 1, 3, refStatus, text_color=refCol2, text_size=size.tiny)

// ─── EXIT SIGNALS (Option 4 — First Trigger Wins) ────────────────────────────
// For an active long: exit on opposite CRT SELL or price closes below EMA
// For an active short: exit on opposite CRT BUY or price closes above EMA

var bool inLong = false
var bool inShort = false

if bullSignal
    inLong := true
    inShort := false
if bearSignal
    inShort := true
    inLong := false

// Exit conditions — first trigger wins:
// 1. Opposite CRT signal
// 2. Bearish/bullish candle closes on wrong side of EMA
exitLong = inLong and (bearSignal or (close < emaVal and bearCandle))
exitShort = inShort and (bullSignal or (close > emaVal and bullCandle))

if exitLong
    inLong := false
if exitShort
    inShort := false

// Exit labels
plotshape(exitLong, "Exit Long", shape.xcross, location.abovebar, color.new(color.white, 20), text="EXIT", textcolor=color.white, size=size.small)
plotshape(exitShort, "Exit Short", shape.xcross, location.belowbar, color.new(color.white, 20), text="EXIT", textcolor=color.white, size=size.small)

// ─── ALERTS ───────────────────────────────────────────────────────────────────

alertcondition(bullSignal, "CRT Buy Signal", "CRT Pro: Bullish sweep & reverse — potential long setup")
alertcondition(bearSignal, "CRT Sell Signal", "CRT Pro: Bearish sweep & reverse — potential short setup")
alertcondition(exitLong, "CRT Exit Long", "CRT Pro: Exit long — opposite signal or EMA cross")
alertcondition(exitShort, "CRT Exit Short", "CRT Pro: Exit short — opposite signal or EMA cross")
alertcondition(bullSignal or bearSignal, "CRT Any Signal", "CRT Pro: Setup detected")

// ─── TRADE LEVELS & TRADE LOG (webhook) ──────────────────────────────────────
// Tracks its own copy of the open trade so every entry gets a matching exit,
// including reversals (a CRT SELL while long closes the long, then opens the
// short). Entry = close of the signal bar. SL = the signal candle's sweep wick
// (low for a long, high for a short) plus the SL buffer. TP1/TP2/TP3 = entry
// plus 1R/2R/3R (settings), where R = entry to SL.
// From the bar after entry, each bar is checked in this order:
//   1. SL touched          -> exit at SL (if SL and a TP touch on the same
//                             bar, SL is assumed first: the conservative read)
//   2. TP1 / TP2 / TP3     -> each new TP logged; TP3 exits at TP3
//   3. Opposite signal     -> exit at close (REVERSE)
//   4. EMA exit            -> exit at close (EMA)
// Times are New York time. Fires on bar close only, so it never repaints.

var string logSide = ""
var string logId = ""
var float logEntry = na
var float logStop = na
var float logTP1 = na
var float logTP2 = na
var float logTP3 = na
var int tpHits = 0
var int entryBar = na
var lvlLines = array.new<line>()
var lvlLabels = array.new<label>()

nyStamp(t) =>
    str.format_time(t, "yyyy-MM-dd HH:mm", "America/New_York")

px(float v) =>
    str.tostring(v, format.mintick)

sendLog(string body) =>
    if logOn
        keyPart = logKey == "" ? "" : ',"key":"' + logKey + '"'
        alert('{"source":"CRT Pro","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '"' + keyPart + ',' + body + '}', alert.freq_once_per_bar_close)

sendExit(string reason, float atPx) =>
    pnlPts = logSide == "LONG" ? atPx - logEntry : logEntry - atPx
    sendLog('"event":"EXIT","id":"' + logId + '","side":"' + logSide + '","time":"' + nyStamp(time_close) +
         '","exit":' + px(atPx) + ',"reason":"' + reason + '","tp_hits":' + str.tostring(tpHits) +
         ',"pnl_pts":' + px(pnlPts))

addLevel(float price, color col, string style, string name) =>
    if showLvls
        array.push(lvlLines, line.new(bar_index, price, bar_index + 1, price, color=col, width=1, style=style))
        array.push(lvlLabels, label.new(bar_index + 1, price, name + " " + px(price), style=label.style_label_left, color=color.new(col, 75), textcolor=col, size=size.small))

newSide = bullSignal ? "LONG" : bearSignal ? "SHORT" : ""
exitReason = ""
exitPx = float(na)

// 1-2. SL and TP levels, from the bar after entry
if logSide != "" and bar_index > entryBar
    isLong = logSide == "LONG"
    slHit = isLong ? low <= logStop : high >= logStop
    if slHit
        exitReason := "SL"
        exitPx := logStop
    else
        reach1 = isLong ? high >= logTP1 : low <= logTP1
        reach2 = isLong ? high >= logTP2 : low <= logTP2
        reach3 = isLong ? high >= logTP3 : low <= logTP3
        reached = reach3 ? 3 : reach2 ? 2 : reach1 ? 1 : 0
        if reached > tpHits
            for k = tpHits + 1 to reached
                tpPx = k == 1 ? logTP1 : k == 2 ? logTP2 : logTP3
                sendLog('"event":"TP","id":"' + logId + '","side":"' + logSide + '","time":"' + nyStamp(time_close) +
                     '","level":"TP' + str.tostring(k) + '","price":' + px(tpPx))
                if showLvls
                    label.new(bar_index, tpPx, "TP" + str.tostring(k), style=isLong ? label.style_label_down : label.style_label_up, color=tpLvlColor, textcolor=color.black, size=size.tiny)
            tpHits := reached
        if tpHits >= 3
            exitReason := "TP3"
            exitPx := logTP3

// 3-4. The indicator's own exits, at the bar's close
if logSide != "" and exitReason == ""
    if newSide != "" and newSide != logSide
        exitReason := "REVERSE"
        exitPx := close
    else if logSide == "LONG" and close < emaVal and bearCandle
        exitReason := "EMA"
        exitPx := close
    else if logSide == "SHORT" and close > emaVal and bullCandle
        exitReason := "EMA"
        exitPx := close

if exitReason != ""
    sendExit(exitReason, exitPx)
    if showLvls and exitReason == "SL"
        label.new(bar_index, logStop, "SL", style=logSide == "LONG" ? label.style_label_up : label.style_label_down, color=slLvlColor, textcolor=color.white, size=size.tiny)
    logSide := ""

// Keep the open trade's lines running to the current bar; they stop where the trade closed.
if array.size(lvlLines) > 0 and (logSide != "" or exitReason != "")
    xEnd = logSide != "" ? bar_index + 1 : bar_index
    for ln in lvlLines
        line.set_x2(ln, xEnd)
    for lb in lvlLabels
        label.set_x(lb, xEnd)

// Open a new trade (a repeat signal in the same direction is ignored).
if newSide != "" and logSide == ""
    isLong = newSide == "LONG"
    buf = slBufTicks * syminfo.mintick
    logSide := newSide
    logEntry := close
    logStop := isLong ? low - buf : high + buf
    risk = math.abs(logEntry - logStop)
    dir = isLong ? 1.0 : -1.0
    logTP1 := logEntry + dir * tp1R * risk
    logTP2 := logEntry + dir * tp2R * risk
    logTP3 := logEntry + dir * tp3R * risk
    tpHits := 0
    entryBar := bar_index
    logId := "CRTPRO-" + str.format_time(time_close, "yyyyMMdd-HHmm", "America/New_York") + "-" + newSide
    array.clear(lvlLines)
    array.clear(lvlLabels)
    addLevel(logEntry, entryLvlColor, line.style_solid, "Entry")
    addLevel(logStop, slLvlColor, line.style_solid, "SL")
    addLevel(logTP1, tpLvlColor, line.style_dashed, "TP1")
    addLevel(logTP2, tpLvlColor, line.style_dashed, "TP2")
    addLevel(logTP3, tpLvlColor, line.style_dashed, "TP3")
    sendLog('"event":"ENTRY","id":"' + logId + '","side":"' + newSide + '","time":"' + nyStamp(time_close) +
         '","entry":' + px(logEntry) + ',"sl":' + px(logStop) + ',"risk_pts":' + px(risk) +
         ',"tp1":' + px(logTP1) + ',"tp2":' + px(logTP2) + ',"tp3":' + px(logTP3) +
         ',"ref_high":' + px(refH) + ',"ref_low":' + px(refL))
