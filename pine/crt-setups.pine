//@version=6
// ==============================================================================
// CRT Setups  |  Indicator  |  Pine Script v6
// ==============================================================================
//   Put this on the 1m chart. Setups come from the 15m chart.
//   C1 : 15m range candle
//   C2 : 15m candle that wicks beyond C1's high (sell) or low (buy) and closes
//        back inside C1
//   C3 : 15m entry candle. Entry zone = C2's close. During C3, enter on a
//        1m candle that either
//          - breaks cleanly: closes in the trade direction, past the entry
//            zone by the clean-break distance
//          - retests: price first moves away from the zone, then a 1m candle
//            comes back to touch it and closes back on the trade side
//        No trigger before C3 ends = no trade.
//   Noise filters: C1 must be at least Min C1 Range tall, and C2 must go at
//        least Min Sweep past C1. No new setups are drawn or taken while a
//        trade is open.
//   Key levels: confirmed 1H and 4H swing highs (resistance) and swing lows
//        (support). A level is removed once a 15m candle closes through it.
//        With "Require Key Level" on, C2 must sweep into a level: a sell C2
//        into resistance, a buy C2 into support.
//   Session levels: Asia high/low, London high/low and the previous day's
//        high/low are added to the key levels once the session is over.
//   Weekly trend: higher/lower daily highs and lows over the last 5 days.
//        Setups against it are tagged "CT" (counter-trend), not blocked.
//   Targets: TP1 = Target Step $ from entry, TP2 = 2 steps, TP3 = 3 steps ...
//        (TP tags are markers only - the trade is not closed there.)
//   Stop:
//        starts at Max Loss $ against you
//        halfway to TP1 -> stop to entry (breakeven)
//        after that, each time a 15m candle closes the stop trails behind it:
//          buy  -> just below that 15m candle's low
//          sell -> just above that 15m candle's high
//        so you stay in while the 15m candles keep stepping your way, and are
//        out when a 15m candle takes out the previous one ("move is over")
//        once a 15m candle CLOSES past Profit Floor $, the stop never sits
//        below that profit
//   Also out when a no-trade window starts. One trade at a time.
// ==============================================================================

indicator("CRT Setups", overlay=true, max_labels_count=500, max_lines_count=500)

// --- SETTINGS -----------------------------------------------------------------

setupTf   = input.timeframe("15", "Setup Timeframe")
minRange  = input.float(8.0, "Min C1 Range (points)", minval=0, step=0.25, tooltip="Skip setups whose C1 range is smaller than this. 8 points = $400 on 1 ES, the TP1 distance. 0 = off.")
minSweep  = input.int(2, "Min Sweep Past C1 (ticks)", minval=1, maxval=40, tooltip="C2 must trade at least this far past C1's high (sell) or low (buy).")
showNoise = input.bool(false, "Show Filtered-Out Setups (small grey)")
bufTicks  = input.int(4, "Clean Break (ticks past zone)", minval=0, maxval=40, tooltip="A clean break is a 1m candle in the trade direction that closes this far past the entry zone. ES: 4 ticks = 1 point.")
awayTicks = input.int(4, "Retest: Move Away First (ticks)", minval=1, maxval=40, tooltip="Before a retest counts, price must first trade this far away from the entry zone in the trade direction.")
maxLoss   = input.float(250, "Max Loss ($)", minval=1, step=25, tooltip="Starting stop. Applies until the stop moves to entry.")
stepUSD   = input.float(400, "Target Step ($)", minval=50, step=50, tooltip="TP1 is this far from entry, TP2 twice as far, and so on. Halfway to TP1 the stop moves to entry.")
trailTks  = input.int(2, "Trail: Ticks Beyond 15m Candle", minval=0, maxval=40, tooltip="After breakeven the stop sits this far beyond the last closed 15m candle's low (buy) or high (sell).")
floorUSD  = input.float(450, "Profit Floor ($, 0 = off)", minval=0, step=25, tooltip="Once a 15m candle closes with at least this much profit, the stop never sits below this profit.")
contracts = input.int(1, "Contracts", minval=1)
trendDays = input.int(5, "Trend: Days to Look Back", minval=2, maxval=10)
noTrade1  = input.session("2300-0300", "No-Trade Window 1 (NY time)")
noTrade2  = input.session("1630-2000", "No-Trade Window 2 (NY time)")
showNoTr  = input.bool(true, "Show Setups in No-Trade Windows (greyed)")
grpLvl    = "Key Levels (1H / 4H)"
needLevel = input.bool(true,  "Require Key Level", group=grpLvl, tooltip="Only take setups where C2's sweep reached a 1H/4H level: resistance for sells, support for buys.")
showLvls  = input.bool(true,  "Show Key Levels", group=grpLvl)
use1h     = input.bool(true,  "1H Levels", group=grpLvl)
use4h     = input.bool(true,  "4H Levels", group=grpLvl)
pivLen    = input.int(3, "Swing Strength (bars each side)", minval=2, maxval=10, group=grpLvl, tooltip="A 1H/4H swing high needs this many lower highs on each side. Higher = fewer, stronger levels.")
maxLvls   = input.int(3, "Levels Kept per Timeframe & Side", minval=1, maxval=10, group=grpLvl)
lvlZone   = input.float(2.0, "Level Zone (points)", minval=0, step=0.25, group=grpLvl, tooltip="How close C2's sweep must come to a level to count. Levels closer than this are merged.")
useAsia   = input.bool(true, "Asia High/Low", group=grpLvl, inline="ses")
useLon    = input.bool(true, "London High/Low", group=grpLvl, inline="ses")
usePD     = input.bool(true, "Prev Day High/Low", group=grpLvl)
asiaSess  = input.session("2000-2359", "Asia Session (NY time)", group=grpLvl)
lonSess   = input.session("0200-0500", "London Session (NY time)", group=grpLvl)
resCol    = input.color(#FF9800, "Resistance Color", group=grpLvl)
supCol    = input.color(#26A69A, "Support Color", group=grpLvl)
buyCol    = input.color(#00C853, "Buy Color")
sellCol   = input.color(#FF1744, "Sell Color")
rangeCol  = input.color(#787B86, "C1 Range Color")
zoneCol   = input.color(#FFD600, "Entry Zone Color")
tpCol     = input.color(#089981, "Target Color")

pv       = syminfo.pointvalue * contracts
buf      = bufTicks * syminfo.mintick
away     = awayTicks * syminfo.mintick
lossPts  = maxLoss / pv
stepPts  = stepUSD / pv
halfPts  = stepPts / 2
trailBuf = trailTks * syminfo.mintick
floorPts = floorUSD / pv

px(float p) => str.tostring(p, format.mintick)
usd(float x) => (x >= 0 ? "+$" : "-$") + str.tostring(math.abs(x), "#,##0")
inWin(string s) => not na(time(timeframe.period, s, "America/New_York"))
blocked = inWin(noTrade1) or inWin(noTrade2)

// --- WEEKLY TREND -------------------------------------------------------------
// Over the last N completed days: +1 for each higher high and each higher low,
// -1 for each lower high and each lower low. Clearly positive = UP, clearly
// negative = DOWN, otherwise RANGE.

trendData(int n) =>
    int score = 0
    for i = 1 to n
        score += (high[i] > high[i + 1] ? 1 : high[i] < high[i + 1] ? -1 : 0) + (low[i] > low[i + 1] ? 1 : low[i] < low[i + 1] ? -1 : 0)
    score

tScore = request.security(syminfo.tickerid, "D", trendData(trendDays), lookahead=barmerge.lookahead_on)
trend  = tScore >= 3 ? 1 : tScore <= -3 ? -1 : 0
trendTxt = trend == 1 ? "UP" : trend == -1 ? "DOWN" : "RANGE"

// --- 15m CANDLES --------------------------------------------------------------
// [1] + lookahead_on = last COMPLETED 15m candles only (no repainting).
// On the first 1m bar of a new 15m candle: C2 = the candle that just closed,
// C1 = the one before it, and C3 = the candle that is starting now.

[c2H, c2L, c2O, c2C, c2T, c1H, c1L, c1T] = request.security(syminfo.tickerid, setupTf, [high[1], low[1], open[1], close[1], time[1], high[2], low[2], time[2]], lookahead=barmerge.lookahead_on)
newC3   = timeframe.change(setupTf)
tfMs    = timeframe.in_seconds(setupTf) * 1000
chartOK = timeframe.in_seconds() < timeframe.in_seconds(setupTf)

// --- KEY LEVELS: 1H / 4H SWING HIGHS & LOWS -----------------------------------

type Level
    float  price
    bool   isRes
    string tf
    line   ln
    label  lb

var array<Level> levels = array.new<Level>()

// Confirmed swing points from the last COMPLETED candle of that timeframe
pivData(int len) =>
    ph = ta.pivothigh(high, len, len)
    pl = ta.pivotlow(low, len, len)
    [ph[1], pl[1], time[len + 1]]

[ph1, pl1, pt1] = request.security(syminfo.tickerid, "60",  pivData(pivLen), lookahead=barmerge.lookahead_on)
[ph4, pl4, pt4] = request.security(syminfo.tickerid, "240", pivData(pivLen), lookahead=barmerge.lookahead_on)
new1h = timeframe.change("60")
new4h = timeframe.change("240")

// Add a level unless one on the same side is already within the zone (then
// the two are merged, e.g. "1H+4H" or "1H+Asia"). Keeps the newest few.
addLevel(array<Level> lv, float p, bool isRes, string tf, int t, int keep) =>
    bool dup = false
    for l in lv
        if not dup and l.isRes == isRes and math.abs(l.price - p) <= lvlZone
            dup := true
            if not str.contains(l.tf, tf)
                l.tf := l.tf + "+" + tf
                line.set_width(l.ln, 2)
                line.set_style(l.ln, line.style_solid)
    if not dup
        col = isRes ? resCol : supCol
        ln  = line.new(t, p, t + 1, p, xloc=xloc.bar_time, extend=extend.right, color=showLvls ? color.new(col, 30) : color.new(col, 100), width=tf == "4H" ? 2 : 1, style=tf == "4H" ? line.style_solid : line.style_dashed)
        lb  = label.new(bar_index, p, tf + " " + px(p), style=label.style_label_left, color=showLvls ? color.new(col, 60) : color.new(col, 100), textcolor=showLvls ? color.white : color.new(color.white, 100), size=size.tiny)
        lv.push(Level.new(p, isRes, tf, ln, lb))
        int cnt = 0
        for i = lv.size() - 1 to 0
            l = lv.get(i)
            if l.isRes == isRes and l.tf == tf
                cnt += 1
                if cnt > keep
                    line.delete(l.ln)
                    label.delete(l.lb)
                    lv.remove(i)
    dup

// Remove levels that a 15m candle closed through
removeBroken(array<Level> lv, float c) =>
    if lv.size() > 0
        for i = lv.size() - 1 to 0
            l = lv.get(i)
            if (l.isRes and c > l.price) or (not l.isRes and c < l.price)
                line.delete(l.ln)
                label.delete(l.lb)
                lv.remove(i)
    true

// Which level (if any) sits inside a price band; merged levels win
levelIn(array<Level> lv, bool wantRes, float lo, float hi) =>
    string tag = ""
    for l in lv
        if l.isRes == wantRes and l.price >= lo and l.price <= hi
            if tag == "" or str.contains(l.tf, "+") or (str.contains(l.tf, "4H") and not str.contains(tag, "+"))
                tag := l.tf
    tag

// Session high/low: returns the final high/low on the first bar after it ends
sessTrack(string sess) =>
    var float h   = na
    var float l   = na
    var int   t0  = na
    var bool  was = false
    inS = inWin(sess)
    fin = was and not inS
    fh  = h
    fl  = l
    ft  = t0
    if inS
        if not was
            h  := high
            l  := low
            t0 := time
        else
            h := math.max(h, high)
            l := math.min(l, low)
    was := inS
    [fin, fh, fl, ft]

[asiaEnd, asiaH, asiaL, asiaT] = sessTrack(asiaSess)
[lonEnd, lonH, lonL, lonT]     = sessTrack(lonSess)
[pdH, pdL, pdT] = request.security(syminfo.tickerid, "D", [high[1], low[1], time[1]], lookahead=barmerge.lookahead_on)
newDay = timeframe.change("D")

// Did C2 sweep into a level? Sell: C2 went from C1's high up to its own high.
// Buy: from C1's low down to its own low. (Checked before this bar's upkeep.)
sellLvl = levelIn(levels, true,  c1H - lvlZone, c2H + lvlZone)
buyLvl  = levelIn(levels, false, c2L - lvlZone, c1L + lvlZone)

sweep   = minSweep * syminfo.mintick
sellRaw = c2H > c1H and c2C < c1H and c2C > c1L
buyRaw  = c2L < c1L and c2C > c1L and c2C < c1H
if sellRaw and buyRaw
    sellRaw := c2C < c2O
    buyRaw  := not sellRaw
// Noise filters
bigC1   = minRange <= 0 or (c1H - c1L) >= minRange
sellCRT = sellRaw and bigC1 and c2H >= c1H + sweep and (not needLevel or sellLvl != "")
buyCRT  = buyRaw and bigC1 and c2L <= c1L - sweep and (not needLevel or buyLvl != "")
noise   = (sellRaw or buyRaw) and not (sellCRT or buyCRT)

// --- TRADE LEVEL TAGS ---------------------------------------------------------
// Small price tags that ride along with price while live, then freeze and
// turn grey when hit.

type Tag
    string name
    float  price
    line   ln
    label  lb
    bool   live

newTag(string name, float p, color bg, color txt) =>
    ln = line.new(bar_index, p, bar_index, p, color=bg, width=1)
    lb = label.new(bar_index, p, name + " " + px(p), style=label.style_label_left, color=bg, textcolor=txt, size=size.tiny)
    Tag.new(name, p, ln, lb, true)

rideTag(Tag t) =>
    if not na(t) and t.live
        line.set_x2(t.ln, bar_index)
        label.set_x(t.lb, bar_index)
    true

freezeTag(Tag t, string suffix, color bg) =>
    if not na(t) and t.live
        t.live := false
        line.set_x2(t.ln, bar_index)
        label.set_x(t.lb, bar_index)
        label.set_color(t.lb, bg)
        label.set_textcolor(t.lb, color.white)
        label.set_text(t.lb, t.name + " " + px(t.price) + suffix)
    true

hitBg  = color.new(color.gray, 25)
fadeBg = color.new(color.gray, 75)

// --- STATE --------------------------------------------------------------------

var int    armDir   = 0      // setup waiting for its 1m trigger during C3
var float  zone     = na     // entry zone = C2 close
var int    armEnd   = na     // time C3 ends
var bool   wentAway = false  // price has moved away from the zone (needed for a retest)
var string armCT    = ""     // " CT" when the setup is counter-trend

var int   dir     = 0        // open trade: 1 long, -1 short, 0 flat
var float ePx     = na
var int   eBar    = na
var float sl      = na       // current (trailing) stop
var float best    = 0.0      // best open profit so far, in points
var Tag   tE      = na
var Tag   tSL     = na
var Tag   tT1     = na
var Tag   tT2     = na
var Tag   tT3     = na
var int   nTrades = 0
var int   nWins   = 0
var float netUSD  = 0.0

// --- 1) C3 STARTS: MARK THE SETUP ---------------------------------------------

if newC3 and barstate.isconfirmed and chartOK
    armDir := 0
    // Filtered-out setup: optional small grey marker
    if noise and showNoise and dir == 0
        label.new(time, sellRaw ? high : low, "noise", xloc=xloc.bar_time, yloc=sellRaw ? yloc.abovebar : yloc.belowbar, style=sellRaw ? label.style_label_down : label.style_label_up, color=color.new(color.gray, 70), textcolor=color.white, size=size.tiny)
    // Only look for a new setup when no trade is open
    if (sellCRT or buyCRT) and dir == 0
        d      = buyCRT ? 1 : -1
        ct     = trend != 0 and d != trend ? " CT" : ""
        lvTag  = d == 1 ? buyLvl : sellLvl
        col    = blocked ? color.gray : d == 1 ? buyCol : sellCol
        faded  = blocked ? 70 : 0
        c3End  = time + tfMs
        if not blocked or showNoTr
            st = d == 1 ? label.style_label_up : label.style_label_down
            line.new(c1T, c1H, c3End, c1H, xloc=xloc.bar_time, color=color.new(blocked ? color.gray : rangeCol, faded), style=line.style_dotted)
            line.new(c1T, c1L, c3End, c1L, xloc=xloc.bar_time, color=color.new(blocked ? color.gray : rangeCol, faded), style=line.style_dotted)
            label.new(c1T, d == 1 ? c1L : c1H, "C1", xloc=xloc.bar_time, style=st, color=color.new(col, 60), textcolor=color.white, size=size.tiny)
            label.new(c2T, d == 1 ? c2L : c2H, "C2", xloc=xloc.bar_time, style=st, color=color.new(col, 40), textcolor=color.white, size=size.tiny)
            label.new(time, d == 1 ? low : high, blocked ? "C3 x" : "C3" + (lvTag != "" ? " " + lvTag : "") + ct, xloc=xloc.bar_time, yloc=d == 1 ? yloc.belowbar : yloc.abovebar, style=st, color=color.new(col, 30), textcolor=color.white, size=size.tiny)
            line.new(c2T, c2C, c3End, c2C, xloc=xloc.bar_time, color=color.new(blocked ? color.gray : zoneCol, faded), width=2)
            label.new(c3End, c2C, px(c2C), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(blocked ? color.gray : zoneCol, 30), textcolor=color.black, size=size.tiny)
        if not blocked
            armDir   := d
            zone     := c2C
            armEnd   := c3End
            wentAway := false
            armCT    := ct
            alert("CRT " + syminfo.ticker + ": " + (d == 1 ? "BUY" : "SELL") + ct + " setup" + (lvTag != "" ? " at " + lvTag + (d == 1 ? " support" : " resistance") : "") + ". Entry zone " + px(c2C) + ". Waiting for a 1m retest or clean break.", alert.freq_once_per_bar_close)

// --- 2) DURING C3: 1m RETEST OR CLEAN BREAK -----------------------------------

if barstate.isconfirmed and armDir != 0 and dir == 0 and time < armEnd and not blocked
    d      = armDir
    brk    = d == 1 ? (close >= zone + buf and close > open) : (close <= zone - buf and close < open)
    retest = wentAway and (d == 1 ? (low <= zone and close > zone) : (high >= zone and close < zone))
    if not wentAway
        wentAway := d == 1 ? high >= zone + away : low <= zone - away
    if retest or brk
        dir    := d
        ePx    := close
        eBar   := bar_index
        sl     := close - d * lossPts
        best   := 0.0
        armDir := 0
        how     = brk ? "break" : "retest"
        label.new(bar_index, d == 1 ? low : high, (d == 1 ? "BUY" : "SELL") + armCT, yloc=d == 1 ? yloc.belowbar : yloc.abovebar, style=d == 1 ? label.style_label_up : label.style_label_down, color=d == 1 ? buyCol : sellCol, textcolor=color.white, size=size.small)
        tE  := newTag("ENTRY", ePx, zoneCol, color.black)
        tSL := newTag("SL", sl, sellCol, color.white)
        tT1 := newTag("TP1", ePx + d * stepPts, tpCol, color.white)
        tT2 := newTag("TP2", ePx + d * 2 * stepPts, tpCol, color.white)
        tT3 := newTag("TP3", ePx + d * 3 * stepPts, tpCol, color.white)
        alert("CRT " + syminfo.ticker + ": " + (d == 1 ? "BUY" : "SELL") + armCT + " @ " + px(ePx) + " (" + how + "). SL " + px(sl) + "  TP1 " + px(ePx + d * stepPts), alert.freq_once_per_bar_close)

// C3 ended without a trigger
if armDir != 0 and time >= armEnd
    armDir := 0

// --- 3) MANAGE THE OPEN TRADE -------------------------------------------------
// The stop is checked against the level set on the previous bars; this bar's
// high/low then moves the trailing stop for the next bar.

exitNow = false
exitPx  = float(na)
exitTxt = ""

if barstate.isconfirmed and dir != 0 and bar_index > eBar
    stopHit = dir == 1 ? low <= sl : high >= sl
    if stopHit
        exitNow := true
        exitPx  := sl
        exitTxt := (sl - ePx) * dir < 0 ? "SL" : (sl - ePx) * dir == 0 ? "BE" : "TRAIL"
        freezeTag(tSL, " (HIT)", hitBg)
    else if blocked
        exitNow := true
        exitPx  := close
        exitTxt := "NO-TRADE TIME"
    else
        // Targets reached this bar
        best := math.max(best, (dir == 1 ? high - ePx : ePx - low))
        if best >= stepPts
            freezeTag(tT1, " (HIT)", hitBg)
        if best >= 2 * stepPts
            freezeTag(tT2, " (HIT)", hitBg)
        if best >= 3 * stepPts
            freezeTag(tT3, " (HIT)", hitBg)
        newSl = sl
        // Halfway to TP1: stop to entry
        if best >= halfPts
            newSl := dir == 1 ? math.max(newSl, ePx) : math.min(newSl, ePx)
        // A 15m candle just closed: after breakeven, trail behind it
        if newC3 and not na(c2H) and (newSl - ePx) * dir >= 0
            candSl = dir == 1 ? c2L - trailBuf : c2H + trailBuf
            newSl := dir == 1 ? math.max(newSl, candSl) : math.min(newSl, candSl)
            // Profit floor once a 15m candle has closed past it
            if floorUSD > 0 and (c2C - ePx) * dir >= floorPts
                newSl := dir == 1 ? math.max(newSl, ePx + floorPts) : math.min(newSl, ePx - floorPts)
        if (newSl - sl) * dir > 0
            sl := newSl
            tSL.price := sl
            line.set_y1(tSL.ln, sl)
            line.set_y2(tSL.ln, sl)
            label.set_y(tSL.lb, sl)
            label.set_text(tSL.lb, "SL " + px(sl) + " (" + usd((sl - ePx) * dir * pv) + ")")
            label.set_color(tSL.lb, (sl - ePx) * dir >= 0 ? tpCol : sellCol)
            alert("CRT " + syminfo.ticker + ": move stop to " + px(sl) + " (" + usd((sl - ePx) * dir * pv) + " locked)", alert.freq_once_per_bar_close)

if exitNow
    pnl = (exitPx - ePx) * dir * pv
    nTrades += 1
    nWins   += pnl > 0 ? 1 : 0
    netUSD  += pnl
    freezeTag(tE, "", fadeBg)
    freezeTag(tSL, "", fadeBg)
    freezeTag(tT1, "", fadeBg)
    freezeTag(tT2, "", fadeBg)
    freezeTag(tT3, "", fadeBg)
    label.new(bar_index, dir == 1 ? high : low, exitTxt + " " + usd(pnl), yloc=dir == 1 ? yloc.abovebar : yloc.belowbar, style=dir == 1 ? label.style_label_down : label.style_label_up, color=pnl > 0 ? color.new(tpCol, 20) : color.new(color.gray, 20), textcolor=color.white, size=size.tiny)
    alert("CRT " + syminfo.ticker + ": EXIT " + exitTxt + " @ " + px(exitPx) + "  Trade " + usd(pnl), alert.freq_once_per_bar_close)
    dir := 0

if dir != 0
    rideTag(tE)
    rideTag(tSL)
    rideTag(tT1)
    rideTag(tT2)
    rideTag(tT3)

// --- KEY LEVEL UPKEEP (after this bar's setup check) --------------------------

if barstate.isconfirmed
    if newC3 and not na(c2C)
        removeBroken(levels, c2C)
    if use4h and new4h
        if not na(ph4)
            addLevel(levels, ph4, true, "4H", pt4, maxLvls)
        if not na(pl4)
            addLevel(levels, pl4, false, "4H", pt4, maxLvls)
    if use1h and new1h
        if not na(ph1)
            addLevel(levels, ph1, true, "1H", pt1, maxLvls)
        if not na(pl1)
            addLevel(levels, pl1, false, "1H", pt1, maxLvls)
    if usePD and newDay and not na(pdH)
        addLevel(levels, pdH, true, "PD", pdT, 1)
        addLevel(levels, pdL, false, "PD", pdT, 1)
    if useAsia and asiaEnd and not na(asiaH)
        addLevel(levels, asiaH, true, "Asia", asiaT, 1)
        addLevel(levels, asiaL, false, "Asia", asiaT, 1)
    if useLon and lonEnd and not na(lonH)
        addLevel(levels, lonH, true, "London", lonT, 1)
        addLevel(levels, lonL, false, "London", lonT, 1)

// Level tags sit at the right edge of the chart
if barstate.islast
    for l in levels
        label.set_xy(l.lb, bar_index + 3, l.price)
        label.set_text(l.lb, l.tf + " " + px(l.price))

// --- STATUS TABLE -------------------------------------------------------------

var table tbl = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 60), border_color=color.new(color.gray, 40), border_width=1)

if barstate.islast
    openPnl = dir != 0 ? (close - ePx) * dir * pv : 0.0
    stTxt   = not chartOK ? "Use a chart below " + setupTf + "m (e.g. 1m)" : dir != 0 ? (dir == 1 ? "LONG " : "SHORT ") + px(ePx) + "  open " + usd(openPnl) + "  SL " + px(sl) : armDir != 0 ? (armDir == 1 ? "BUY" : "SELL") + armCT + " setup - zone " + px(zone) : blocked ? "No-trade time" : "Waiting for a setup"
    winPct  = nTrades > 0 ? 100.0 * nWins / nTrades : 0.0
    table.cell(tbl, 0, 0, "CRT", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 0, setupTf + "m setups -> " + timeframe.period + " entries", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 1, "Trend", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 1, trendTxt + " (" + str.tostring(trendDays) + " days, score " + str.tostring(tScore) + ")", text_color=trend == 1 ? buyCol : trend == -1 ? sellCol : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 2, "Status", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 2, stTxt, text_color=dir == 1 or armDir == 1 ? buyCol : dir == -1 or armDir == -1 ? sellCol : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 3, "Results", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 3, str.tostring(nTrades) + " trades - " + str.tostring(winPct, "#") + "% win - " + usd(netUSD), text_color=netUSD >= 0 ? color.lime : color.red, text_size=size.tiny)
