//@version=6
// ══════════════════════════════════════════════════════════════════════════════
// CRT Basic + Key Levels — Candle Range Theory  |  Indicator  |  Pine Script v6
// ══════════════════════════════════════════════════════════════════════════════
//   CRT (15m by default)
//   Candle 1 : the range candle
//   Candle 2 : wicks beyond Candle 1's low (or high) and CLOSES back inside,
//              closing in the trade direction (green for buys, red for sells)
//   Candle 3 : the signal — enter at Candle 3's open
//   Stop     : beyond Candle 2's wick
//   TP1      : 50% of Candle 1 → close part, stop to breakeven
//   TP2      : far side of Candle 1 → close part
//   TP3      : beyond Candle 1 by a % of its range → close the rest
//   One trade at a time. Setups are skipped if the stop risks more than Max $.
//
//   Key levels (1H and 4H)
//   Swing highs = resistance, swing lows = support, confirmed swings only.
//   A level is removed once a 15m candle closes through it.
//
//   Alerts: "Any alert() function call" sends JSON for a webhook (e.g. Google
//   Apps Script → Google Sheet) or plain text, per the Alert Format setting.
// ══════════════════════════════════════════════════════════════════════════════

indicator("CRT Basic", overlay=true, max_labels_count=500, max_lines_count=500)

// ─── SETTINGS ─────────────────────────────────────────────────────────────────

grpCrt    = "CRT"
setupTf   = input.timeframe("15", "CRT Timeframe", group=grpCrt, tooltip="Candles 1-3 come from this timeframe. Use it on the 15m chart, or on a lower chart (e.g. 1m) to follow the trade bar by bar.")
minRange  = input.float(0.5, "Min Candle 1 Size (× ATR)", minval=0, step=0.1, group=grpCrt, tooltip="Skip small, quiet range candles. 0 = off.")
bufTicks  = input.int(2, "Stop Buffer (ticks)", minval=0, maxval=40, group=grpCrt)
maxRisk   = input.float(500, "Max Risk per Trade ($)", minval=1, step=25, group=grpCrt, tooltip="Skip any setup whose stop would risk more than this.")
contracts = input.int(1, "Contracts", minval=1, group=grpCrt)
tp1Pct    = input.int(50, "Close at TP1 (%)", minval=0, maxval=100, group=grpCrt, tooltip="TP1 = 50% of Candle 1. Close this much there and move the stop to breakeven.")
tp2Pct    = input.int(25, "Close at TP2 (%)", minval=0, maxval=100, group=grpCrt, tooltip="TP2 = far side of Candle 1. The rest rides to TP3.")
tp3Ext    = input.float(50, "TP3 Beyond TP2 (% of Candle 1)", minval=0, step=5, group=grpCrt, tooltip="TP3 = TP2 plus this much of Candle 1's range. 0 = no TP3 (everything left closes at TP2).")
useSess   = input.bool(true, "Only Trade During Sessions (NY time)", group=grpCrt, tooltip="Checked at Candle 3's open.")
sess1     = input.session("0930-1130", "Session 1", group=grpCrt)
sess2     = input.session("1400-1600", "Session 2", group=grpCrt)

grpLvl    = "Key Levels (1H / 4H)"
showLvls  = input.bool(true,  "Show Key Levels", group=grpLvl)
use1h     = input.bool(true,  "1H Levels", group=grpLvl)
use4h     = input.bool(true,  "4H Levels", group=grpLvl)
pivLen    = input.int(3, "Swing Strength (bars each side)", minval=2, maxval=10, group=grpLvl, tooltip="A swing high needs this many lower highs on each side (on that timeframe). Higher = fewer, stronger levels.")
maxLvls   = input.int(3, "Levels per Timeframe & Side", minval=1, maxval=10, group=grpLvl, tooltip="Keep this many of the most recent support and resistance levels per timeframe.")
zonePts   = input.float(2.0, "Level Zone (pts)", minval=0, step=0.25, group=grpLvl, tooltip="How close price must come to a level to count as touching it. Levels closer together than this are merged.")
needLevel = input.bool(false, "Only Take CRTs That Sweep a Key Level", group=grpLvl, tooltip="Buy only when Candle 2's wick swept into a 1H/4H support; sell only when it swept into a resistance.")

grpAlert  = "Alerts / Webhook"
alertFmt  = input.string("JSON (webhook)", "Alert Format", options=["JSON (webhook)", "Text"], group=grpAlert, tooltip="JSON for a webhook (Google Sheet tracking). Text for readable phone/email alerts.")
hookKey   = input.string("", "Webhook Key", group=grpAlert, tooltip="Any password. Put the same value in the Apps Script SECRET so the sheet only accepts your alerts.")

grpStyle  = "Style"
showTable = input.bool(true, "Show Stats Table", group=grpStyle)
bullCol   = input.color(#00E676, "Buy Color", group=grpStyle)
bearCol   = input.color(#FF1744, "Sell Color", group=grpStyle)
entryCol  = input.color(#FFD600, "Entry Color", group=grpStyle)
tpCol     = input.color(#089981, "Target Color", group=grpStyle)
resCol    = input.color(#FF9800, "Resistance Color", group=grpStyle)
supCol    = input.color(#26A69A, "Support Color", group=grpStyle)

pv     = syminfo.pointvalue * contracts
buf    = bufTicks * syminfo.mintick
isJson = alertFmt == "JSON (webhook)"

px(float p) => str.tostring(p, format.mintick)
usd(float x) => (x >= 0 ? "+$" : "-$") + str.tostring(math.abs(x), "#,##0")

// JSON helpers for webhook alerts
jStr(string k, string v) => '"' + k + '":"' + v + '"'
jNum(string k, float v, string f) => '"' + k + '":' + (na(v) ? "null" : str.tostring(v, f))
jHead(string ev, string id) => "{" + jStr("key", hookKey) + "," + jStr("event", ev) + "," + jStr("id", id) + "," + jStr("symbol", syminfo.ticker) + "," + jStr("time", str.format_time(time, "yyyy-MM-dd HH:mm", "America/New_York"))

// ─── CANDLE 1 & CANDLE 2 ──────────────────────────────────────────────────────
// Higher timeframe: [1] + lookahead_on = last COMPLETED candles only (no repaint).
// Same timeframe: Candle 2 is the bar that just closed.

sameTf = timeframe.in_seconds(setupTf) <= timeframe.in_seconds()

crtData() =>
    [high[1], low[1], open[1], close[1], high[2], low[2], ta.atr(14)[2]]

[hC2H, hC2L, hC2O, hC2C, hC1H, hC1L, hATR] = request.security(syminfo.tickerid, setupTf, crtData(), lookahead=barmerge.lookahead_on)

atrNow = ta.atr(14)
tfNew  = timeframe.change(setupTf)

c2H   = sameTf ? high      : hC2H
c2L   = sameTf ? low       : hC2L
c2O   = sameTf ? open      : hC2O
c2C   = sameTf ? close     : hC2C
c1H   = sameTf ? high[1]   : hC1H
c1L   = sameTf ? low[1]    : hC1L
c1ATR = sameTf ? atrNow[1] : hATR

// Candle 2 has just closed: at this bar's close (same TF), or on the first
// chart bar of Candle 3 (lower chart)
c2Done = sameTf ? barstate.isconfirmed : tfNew

c1Ok  = minRange <= 0 or (c1H - c1L) >= c1ATR * minRange

// ─── KEY LEVELS: 1H / 4H SWING HIGHS & LOWS ───────────────────────────────────

type Level
    float  price
    bool   isRes
    string tf
    line   ln
    label  lb

var array<Level> levels = array.new<Level>()

// Confirmed swing points from the last COMPLETED candle of that timeframe
pivData(int len) =>
    ph = ta.pivothigh(high, len, len)
    pl = ta.pivotlow(low, len, len)
    [ph[1], pl[1], time[len + 1]]

[ph1, pl1, pt1] = request.security(syminfo.tickerid, "60",  pivData(pivLen), lookahead=barmerge.lookahead_on)
[ph4, pl4, pt4] = request.security(syminfo.tickerid, "240", pivData(pivLen), lookahead=barmerge.lookahead_on)
new1h = timeframe.change("60")
new4h = timeframe.change("240")

// Add a level unless one on the same side is already within the zone
// (a 4H swing on top of a 1H level upgrades it). Keeps the newest maxN per timeframe & side.
addLevel(array<Level> lv, float p, bool isRes, string tf, int t) =>
    bool dup = false
    for l in lv
        if l.isRes == isRes and math.abs(l.price - p) <= zonePts
            dup := true
            if tf == "4H" and l.tf == "1H"
                l.tf := "1H+4H"
                line.set_width(l.ln, 2)
                line.set_style(l.ln, line.style_solid)
    if not dup
        col = isRes ? resCol : supCol
        ln  = line.new(t, p, t + 1, p, xloc=xloc.bar_time, extend=extend.right, color=showLvls ? color.new(col, 25) : color.new(col, 100), width=tf == "4H" ? 2 : 1, style=tf == "4H" ? line.style_solid : line.style_dashed)
        lb  = label.new(bar_index, p, tf + (isRes ? " R " : " S ") + px(p), style=label.style_label_left, color=showLvls ? color.new(col, 60) : color.new(col, 100), textcolor=showLvls ? color.white : color.new(color.white, 100), size=size.tiny)
        lv.push(Level.new(p, isRes, tf, ln, lb))
        int cnt = 0
        for i = lv.size() - 1 to 0
            l = lv.get(i)
            if l.isRes == isRes and l.tf == tf
                cnt += 1
                if cnt > maxLvls
                    line.delete(l.ln)
                    label.delete(l.lb)
                    lv.remove(i)
    dup

// Remove levels that a CRT-timeframe candle closed through
removeBroken(array<Level> lv, float c) =>
    if lv.size() > 0
        for i = lv.size() - 1 to 0
            l = lv.get(i)
            if (l.isRes and c > l.price) or (not l.isRes and c < l.price)
                line.delete(l.ln)
                label.delete(l.lb)
                lv.remove(i)
    true

// Which key level (if any) sits inside a price band; 4H wins over 1H
levelIn(array<Level> lv, bool wantRes, float lo, float hi) =>
    string tag = ""
    for l in lv
        if l.isRes == wantRes and l.price >= lo and l.price <= hi
            if tag == "" or str.contains(l.tf, "4H")
                tag := l.tf
    tag

// Nearest opposing key level strictly between entry and target
obstacle(array<Level> lv, bool wantRes, float fromPx, float toPx) =>
    float best = na
    string tag = ""
    for l in lv
        if l.isRes == wantRes
            between = wantRes ? (l.price > fromPx and l.price < toPx) : (l.price < fromPx and l.price > toPx)
            if between and (na(best) or math.abs(l.price - fromPx) < math.abs(best - fromPx))
                best := l.price
                tag  := l.tf
    [best, tag]

// Did Candle 2 sweep into a key level? (checked before this bar removes broken levels)
bullLvl = levelIn(levels, false, c2L - zonePts, c1L + zonePts)
bearLvl = levelIn(levels, true,  c1H - zonePts, c2H + zonePts)

// ─── CRT SETUPS (Candle 1 + Candle 2) ─────────────────────────────────────────

bullCRT = c1Ok and c2L < c1L and c2C > c1L and c2C < c1H and c2C > c2O and (not needLevel or bullLvl != "")
bearCRT = c1Ok and c2H > c1H and c2C < c1H and c2C > c1L and c2C < c2O and (not needLevel or bearLvl != "")

inSess(s) => not na(time(timeframe.period, s, "America/New_York"))
inSession = not useSess or not timeframe.isintraday or inSess(sess1) or inSess(sess2)

// Same timeframe: the setup found at Candle 2's close is held for one bar,
// then traded on Candle 3. Lower chart: Candle 3 starts on this very bar.
var int    pDir = 0
var int    pBar = na
var float  pC1H = na
var float  pC1L = na
var float  pC2H = na
var float  pC2L = na
var string pTag = ""

setDir = c2Done ? (bullCRT ? 1 : bearCRT ? -1 : 0) : 0
cDir   = sameTf ? (bar_index == pBar + 1 ? pDir : 0) : setDir
cC1H   = sameTf ? pC1H : c1H
cC1L   = sameTf ? pC1L : c1L
cC2H   = sameTf ? pC2H : c2H
cC2L   = sameTf ? pC2L : c2L
cTag   = sameTf ? pTag : (setDir == 1 ? bullLvl : setDir == -1 ? bearLvl : "")

// ─── TRADE LEVEL TAGS ─────────────────────────────────────────────────────────
// Each level (ENTRY, SL, TP1-3) is a line with a price tag at its right end.
// While live, the line and tag ride along with the newest bar. When the level
// is hit, the tag freezes at that bar and turns grey with "(HIT)".

type Tag
    string name
    float  price
    line   ln
    label  lb
    bool   live

newTag(string name, float p, color bg, color txt) =>
    ln = line.new(bar_index, p, bar_index, p, color=bg, width=2)
    lb = label.new(bar_index, p, name + "  " + px(p), style=label.style_label_left, color=bg, textcolor=txt, size=size.small)
    Tag.new(name, p, ln, lb, true)

rideTag(Tag t) =>
    if not na(t) and t.live
        line.set_x2(t.ln, bar_index)
        label.set_x(t.lb, bar_index)
    true

freezeTag(Tag t, string suffix, color bg, color txt) =>
    if not na(t) and t.live
        t.live := false
        line.set_x2(t.ln, bar_index)
        label.set_x(t.lb, bar_index)
        label.set_color(t.lb, bg)
        label.set_textcolor(t.lb, txt)
        label.set_text(t.lb, t.name + "  " + px(t.price) + suffix)
    true

hitBg   = color.new(color.gray, 25)
fadeBg  = color.new(color.gray, 75)
fadeTxt = color.new(color.white, 40)

// ─── TRADE STATE ──────────────────────────────────────────────────────────────

var int   dir       = 0      // 1 = long, -1 = short, 0 = flat
var int   eBar      = na
var int   eTime     = na
var float ePx       = na
var float sl        = na
var float tp1       = na
var float tp2       = na
var float tp3       = na
var float f1        = 0.0    // size closed at each target
var float f2        = 0.0
var float f3        = 0.0
var int   tpIdx     = 1      // next target to hit
var bool  beMoved   = false
var float remaining = 1.0
var float banked    = 0.0    // points locked in at targets (already weighted by size)
var float riskUSD   = na
var Tag   tE        = na
var Tag   tSL       = na
var Tag   tT1       = na
var Tag   tT2       = na
var Tag   tT3       = na
var int   nTrades   = 0
var int   nWins     = 0
var float netUSD    = 0.0

tid() => syminfo.ticker + "-" + str.tostring(eTime)

// ─── CANDLE 3: ENTRY AT ITS OPEN ──────────────────────────────────────────────

flatAtOpen = dir == 0
c3Rng      = cC1H - cC1L
c3Mid      = (cC1H + cC1L) / 2
c3Stop     = cDir == 1 ? cC2L - buf : cC2H + buf
c3RiskUSD  = math.abs(open - c3Stop) * pv
c3PriceOK  = cDir == 1 ? (open > c3Stop and open < cC1H) : (open < c3Stop and open > cC1L)
isC3       = cDir != 0 and flatAtOpen and inSession
goNow      = isC3 and c3PriceOK and c3RiskUSD <= maxRisk

// Valid CRT but skipped because the stop is too far or price already left
if isC3 and not goNow
    why = c3RiskUSD > maxRisk ? "risk $" + str.tostring(math.round(c3RiskUSD)) + " > max" : "price already moved"
    label.new(bar_index, cDir == 1 ? low : high, "CRT " + (cDir == 1 ? "buy" : "sell") + " skipped\n" + why, yloc=cDir == 1 ? yloc.belowbar : yloc.abovebar, style=cDir == 1 ? label.style_label_up : label.style_label_down, color=color.new(color.gray, 60), textcolor=color.white, size=size.tiny)
    alert(isJson ? jHead("SKIP", "") + "," + jStr("side", cDir == 1 ? "LONG" : "SHORT") + "," + jStr("reason", why) + "}" : "CRT " + syminfo.ticker + ": " + (cDir == 1 ? "buy" : "sell") + " skipped, " + why, alert.freq_once_per_bar)

if goNow
    dir       := cDir
    ePx       := open
    eBar      := bar_index
    eTime     := time
    sl        := c3Stop
    tp2       := dir == 1 ? cC1H : cC1L
    tp1       := (dir == 1 and ePx < c3Mid) or (dir == -1 and ePx > c3Mid) ? c3Mid : na
    tp3       := tp3Ext > 0 ? tp2 + dir * c3Rng * tp3Ext / 100 : na
    tpIdx     := 1
    beMoved   := false
    remaining := 1.0
    banked    := 0.0
    riskUSD   := math.abs(ePx - sl) * pv
    // Position split across targets; a missing TP1 or TP3 hands its share to TP2
    f1 := tp1Pct / 100.0
    f2 := math.min(tp2Pct / 100.0, 1 - f1)
    f3 := 1 - f1 - f2
    if na(tp3)
        f2 += f3
        f3 := 0.0
    if na(tp1)
        f2 += f1
        f1 := 0.0
    // Signal + level tags
    [obPx, obTag] = obstacle(levels, dir == 1, ePx, tp2)
    obTxt = na(obPx) ? "" : obTag + (dir == 1 ? " R " : " S ") + px(obPx)
    label.new(bar_index, dir == 1 ? low : high, (dir == 1 ? "BUY" : "SELL") + "\nCRT" + (cTag != "" ? " + " + cTag + (dir == 1 ? " S" : " R") : ""), yloc=dir == 1 ? yloc.belowbar : yloc.abovebar, style=dir == 1 ? label.style_label_up : label.style_label_down, color=dir == 1 ? bullCol : bearCol, textcolor=color.white, size=size.large)
    tE  := newTag("ENTRY", ePx, entryCol, color.black)
    tSL := newTag("SL", sl, bearCol, color.white)
    tT1 := na(tp1) ? na : newTag("TP1", tp1, tpCol, color.white)
    tT2 := newTag("TP2", tp2, tpCol, color.white)
    tT3 := na(tp3) or f3 <= 0 ? na : newTag("TP3", tp3, tpCol, color.white)
    msgJ = jHead("ENTRY", tid()) + "," + jStr("ctf", setupTf) + "," + jStr("side", dir == 1 ? "LONG" : "SHORT") + "," + jNum("entry", ePx, format.mintick) + "," + jNum("sl", sl, format.mintick) + "," + jNum("tp1", tp1, format.mintick) + "," + jNum("tp2", tp2, format.mintick) + "," + jNum("tp3", f3 > 0 ? tp3 : na, format.mintick) + "," + jNum("risk_usd", riskUSD, "#.##") + "," + jStr("swept", cTag) + "," + jStr("obstacle", obTxt) + "," + jNum("contracts", contracts, "#") + "}"
    msgT = "CRT " + syminfo.ticker + ": " + (dir == 1 ? "BUY " : "SELL ") + px(ePx) + "  SL " + px(sl) + (na(tp1) ? "" : "  TP1 " + px(tp1)) + "  TP2 " + px(tp2) + (f3 > 0 ? "  TP3 " + px(tp3) : "") + "  risk $" + str.tostring(math.round(riskUSD)) + (cTag != "" ? "  (swept " + cTag + " level)" : "")
    alert(isJson ? msgJ : msgT, alert.freq_once_per_bar)

// ─── MANAGE OPEN TRADE ────────────────────────────────────────────────────────
// Checked at each bar's close, including Candle 3 itself (the trade is live
// from its open). Targets are taken in order; after the first target the stop
// moves to breakeven. If a bar touches the stop and a target, the stop is
// assumed first (conservative).

exitNow = false
exitPx  = float(na)
exitTxt = ""

if barstate.isconfirmed and dir != 0 and bar_index >= eBar
    slHit = dir == 1 ? low <= sl : high >= sl
    if slHit
        exitNow := true
        exitPx  := sl
        exitTxt := beMoved ? "BE" : "SL"
    else if tpIdx <= 3
        for k = tpIdx to 3
            p = k == 1 ? tp1 : k == 2 ? tp2 : tp3
            f = k == 1 ? f1 : k == 2 ? f2 : f3
            if na(p) or f <= 0
                tpIdx := k + 1
                continue
            if not (dir == 1 ? high >= p : low <= p)
                break
            banked    += f * (p - ePx) * dir
            remaining -= f
            tpIdx     := k + 1
            freezeTag(k == 1 ? tT1 : k == 2 ? tT2 : tT3, "  (HIT)", hitBg, color.white)
            if remaining <= 0.0001
                exitNow := true
                exitPx  := p
                exitTxt := "TP" + str.tostring(k)
                break
            msgJ = jHead("TP" + str.tostring(k), tid()) + "," + jNum("price", p, format.mintick) + "," + jNum("closed_pct", f * 100, "#") + "," + jNum("banked_usd", banked * pv, "#.##") + "," + jNum("new_sl", ePx, format.mintick) + "}"
            msgT = "CRT " + syminfo.ticker + ": TP" + str.tostring(k) + " hit @ " + px(p) + ". Close " + str.tostring(math.round(f * 100)) + "%, stop at breakeven " + px(ePx)
            alert(isJson ? msgJ : msgT, alert.freq_once_per_bar_close)
            // First target banked: stop to breakeven (the ENTRY tag becomes the stop)
            if not beMoved
                beMoved := true
                freezeTag(tSL, "  → BE", fadeBg, fadeTxt)
                sl := ePx
                tE.name := "BE STOP"
                label.set_text(tE.lb, "BE STOP  " + px(ePx))
                label.set_color(tE.lb, bearCol)
                label.set_textcolor(tE.lb, color.white)

if exitNow
    pnlUSD = (banked + remaining * (exitPx - ePx) * dir) * pv
    nTrades += 1
    nWins   += pnlUSD > 0 ? 1 : 0
    netUSD  += pnlUSD
    if exitTxt == "SL"
        freezeTag(tSL, "  (HIT)", hitBg, color.white)
    if exitTxt == "BE"
        freezeTag(tE, "  (HIT)", hitBg, color.white)
    // Everything still live freezes here, faded
    freezeTag(tE,  "", fadeBg, fadeTxt)
    freezeTag(tSL, "", fadeBg, fadeTxt)
    freezeTag(tT1, "", fadeBg, fadeTxt)
    freezeTag(tT2, "", fadeBg, fadeTxt)
    freezeTag(tT3, "", fadeBg, fadeTxt)
    label.new(bar_index, dir == 1 ? high : low, exitTxt + "  " + usd(pnlUSD), yloc=dir == 1 ? yloc.abovebar : yloc.belowbar, style=dir == 1 ? label.style_label_down : label.style_label_up, color=pnlUSD > 0 ? color.new(tpCol, 20) : color.new(color.gray, 20), textcolor=color.white, size=size.small)
    msgJ = jHead("EXIT", tid()) + "," + jNum("price", exitPx, format.mintick) + "," + jStr("reason", exitTxt) + "," + jNum("pnl_usd", pnlUSD, "#.##") + "," + jNum("r_multiple", riskUSD > 0 ? pnlUSD / riskUSD : na, "#.##") + "}"
    msgT = "CRT " + syminfo.ticker + ": EXIT " + exitTxt + " @ " + px(exitPx) + "  Trade " + usd(pnlUSD)
    alert(isJson ? msgJ : msgT, alert.freq_once_per_bar_close)
    dir := 0

// Live tags ride along with the newest bar
if dir != 0
    rideTag(tE)
    rideTag(tSL)
    rideTag(tT1)
    rideTag(tT2)
    rideTag(tT3)

// ─── HOLD THIS BAR'S SETUP FOR CANDLE 3 (same timeframe only) ─────────────────

if sameTf and barstate.isconfirmed
    pDir := setDir
    pBar := bar_index
    pC1H := c1H
    pC1L := c1L
    pC2H := c2H
    pC2L := c2L
    pTag := setDir == 1 ? bullLvl : setDir == -1 ? bearLvl : ""

// ─── KEY LEVEL UPKEEP (after this bar's signals) ──────────────────────────────

if barstate.isconfirmed
    if c2Done
        removeBroken(levels, c2C)
    if use4h and new4h
        if not na(ph4)
            addLevel(levels, ph4, true, "4H", pt4)
        if not na(pl4)
            addLevel(levels, pl4, false, "4H", pt4)
    if use1h and new1h
        if not na(ph1)
            addLevel(levels, ph1, true, "1H", pt1)
        if not na(pl1)
            addLevel(levels, pl1, false, "1H", pt1)

// Level tags sit at the right edge of the chart
if barstate.islast
    for l in levels
        label.set_xy(l.lb, bar_index + 3, l.price)
        label.set_text(l.lb, l.tf + (l.isRes ? " R " : " S ") + px(l.price))

// ─── STATS TABLE ──────────────────────────────────────────────────────────────

var table tbl = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 60), border_color=color.new(color.gray, 40), border_width=1)

if showTable and barstate.islast
    tfTxt  = sameTf ? timeframe.period + " chart" : setupTf + " CRT → " + timeframe.period + " chart"
    nextTp = tpIdx <= 1 and not na(tp1) ? tp1 : tpIdx <= 2 ? tp2 : tp3
    posTxt = dir == 0 ? "FLAT" : (dir == 1 ? "LONG " : "SHORT ") + px(ePx) + "  SL " + px(sl) + "  next TP " + px(nextTp)
    winPct = nTrades > 0 ? 100.0 * nWins / nTrades : 0.0
    table.cell(tbl, 0, 0, "CRT", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 0, tfTxt, text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 1, "Position", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 1, posTxt, text_color=dir == 1 ? bullCol : dir == -1 ? bearCol : color.gray, text_size=size.small)
    table.cell(tbl, 0, 2, "Results", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(nTrades) + " trades · " + str.tostring(winPct, "#") + "% win · " + usd(netUSD), text_color=netUSD >= 0 ? color.lime : color.red, text_size=size.small)
